# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agentic_rag
DB_USER=postgres
DB_PASSWORD=your_database_password

# Server Configuration
PORT=4000

# Authentication Configuration (REQUIRED)
# MUST provide at least one valid API key
VALID_API_KEYS=dev-key-123,prod-key-456,admin-key-789

# Microservices Configuration
MICROSERVICE_API_URL=http://your-microservice-url
MICROSERVICE_API_TOKEN=your-microservice-api-token

# AI Models Configuration
EMBEDDING_MODEL=text-embedding-3-small
AUTOTAG_MODEL=gpt-4o-mini